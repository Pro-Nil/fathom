{
  "name": "@fathom/tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Nil/fathom.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@fathom/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@fathom/agent": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/terminal": "workspace:^",
    "@fathom/output-retention": "workspace:^",
    "@fathom/system-prompt": "workspace:^",
    "@fathom/jobs": "workspace:^",
    "@fathom/tools": "workspace:^",
    "@fathom/cordis": "workspace:^"
  },
  "devDependencies": {
    "@fathom/cordis-plugin-include": "workspace:^",
    "@fathom/cordis-plugin-loader": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/terminal": "workspace:^",
    "@fathom/terminal-bash": "workspace:^",
    "@fathom/output-retention": "workspace:^",
    "@fathom/sandbox": "workspace:^",
    "@fathom/sandbox-policy": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/subprocess-local": "workspace:^",
    "@fathom/system-prompt": "workspace:^",
    "@fathom/jobs": "workspace:^",
    "@fathom/jobs-local": "workspace:^",
    "@fathom/tool-jobs": "workspace:^",
    "@fathom/tools": "workspace:^",
    "@fathom/cordis": "workspace:^"
  }
}
