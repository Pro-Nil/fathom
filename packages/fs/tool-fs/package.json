{
  "name": "@fathom/tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Fathom filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Nil/fathom.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@fathom/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@fathom/attachment": "workspace:^",
    "@fathom/fs": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/sandbox": "workspace:^",
    "@fathom/sandbox-policy": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/system-prompt": "workspace:^",
    "@fathom/tools": "workspace:^",
    "@fathom/user-approval": "workspace:^",
    "@fathom/cordis": "workspace:^",
    "@fathom/session-folders": "workspace:^"
  },
  "devDependencies": {
    "@fathom/cordis": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/agent-loop": "workspace:^",
    "@fathom/agent-loop-testkit": "workspace:^",
    "@fathom/attachment": "workspace:^",
    "@fathom/fs": "workspace:^",
    "@fathom/fs-local": "workspace:^",
    "@fathom/fs-observation-policy": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/llm-pi-ai": "workspace:^",
    "@fathom/sandbox": "workspace:^",
    "@fathom/sandbox-policy": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/session-folders": "workspace:^",
    "@fathom/system-prompt": "workspace:^",
    "@fathom/tools": "workspace:^",
    "@fathom/user-approval": "workspace:^"
  }
