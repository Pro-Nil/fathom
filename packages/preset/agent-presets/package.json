{
  "name": "@fathom/agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Fathom",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Nil/fathom.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fathom/cordis-plugin-include": "workspace:^",
    "@fathom/cordis-plugin-loader": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/atomic-write": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/home-paths": "workspace:^",
    "@fathom/scope": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/settings": "workspace:^",
    "@fathom/system-prompt": "workspace:^",
    "@fathom/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@fathom/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@fathom/cordis-plugin-include": "workspace:^",
    "@fathom/cordis-plugin-loader": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/agent-loop": "workspace:^",
    "@fathom/atomic-write": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/home-paths": "workspace:^",
    "@fathom/scope": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/settings": "workspace:^",
    "@fathom/settings-file": "workspace:^",
    "@fathom/system-prompt": "workspace:^",
    "@fathom/tools": "workspace:^",
    "@fathom/cordis": "workspace:^"
  }
}
