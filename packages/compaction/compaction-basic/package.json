{
  "name": "@fathom/compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the Fathom",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Nil/fathom.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fathom/agent": "workspace:^",
    "@fathom/compaction": "workspace:^",
    "@fathom/commands": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/token-meter": "workspace:^",
    "@fathom/compaction-tool-result-pruner": "workspace:^",
    "@fathom/cordis": "workspace:^",
    "@fathom/settings": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@fathom/compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@fathom/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@fathom/cordis-plugin-include": "workspace:^",
    "@fathom/cordis-plugin-loader": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/agent-loop": "workspace:^",
    "@fathom/agent-loop-testkit": "workspace:^",
    "@fathom/compaction": "workspace:^",
    "@fathom/commands": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/llm-retry": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/token-meter": "workspace:^",
    "@fathom/compaction-tool-result-pruner": "workspace:^",
    "@fathom/tools": "workspace:^",
    "@fathom/cordis": "workspace:^",
    "@fathom/settings": "workspace:^"
  }
}
