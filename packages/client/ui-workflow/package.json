{
  "name": "@fathom/client-ui-workflow",
  "description": "Live agent-run workflow tab: turns, steps, and tool calls rendered as a live stream beside Chat / Trajectory / Bounty",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Nil/fathom.git",
    "directory": "packages/client/ui-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "fathom": {
    "client": {
      "inject": [
        "@fathom/client-locale",
        "@fathom/client-runtime",
        "@fathom/client-ui-conversation",
        "@fathom/client-ui-trajectory"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@fathom/client-locale": "workspace:^",
    "@fathom/client-runtime": "workspace:^",
    "@fathom/client-ui-conversation": "workspace:^",
    "@fathom/client-ui-trajectory": "workspace:^",
    "@fathom/cordis": "workspace:^"
  },
  "devDependencies": {
    "@fathom/client-locale": "workspace:^",
    "@fathom/client-runtime": "workspace:^",
    "@fathom/client-ui-conversation": "workspace:^",
    "@fathom/client-ui-primitives": "workspace:^",
    "@fathom/client-ui-slots": "workspace:^",
    "@fathom/client-ui-trajectory": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@fathom/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
}
