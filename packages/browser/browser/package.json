{
  "name": "@pentest-harness/dsh-browser",
  "description": "Shared browser for Pentest Harness: one persistent Edge/Chromium session (ctx.browser) driven by the agent's browser tools, with a live view the user can watch and take over",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S1N6H/pentest-harness.git",
    "directory": "packages/browser/browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@pentest-harness/dsh-home-paths": "workspace:^",
    "@pentest-harness/dsh-host-webserver": "workspace:^",
    "@pentest-harness/dsh-invariants": "workspace:^",
    "@pentest-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@pentest-harness/schemastery": "workspace:^",
    "playwright-core": "1.62.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@pentest-harness/dsh-home-paths": "workspace:^",
    "@pentest-harness/dsh-host-webserver": "workspace:^",
    "@pentest-harness/dsh-invariants": "workspace:^",
    "@pentest-harness/cordis": "workspace:^",
    "@types/ws": "^8.18.1"
  }
}
