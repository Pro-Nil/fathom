{
  "name": "@fathom/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Fathom SDK clients",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Nil/fathom.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@fathom/llm-pi-ai": "workspace:^",
    "@fathom/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@fathom/cordis": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/llm-pi-ai": "workspace:^",
    "@fathom/scope": "workspace:^",
    "@fathom/sdk-protocol": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/subagent": "workspace:^"
  },
  "devDependencies": {
    "@fathom/cordis": "workspace:^",
    "@fathom/cordis-plugin-loader": "workspace:^",
    "@fathom/agent": "workspace:^",
    "@fathom/agent-spine-demo": "workspace:^",
    "@fathom/invariants": "workspace:^",
    "@fathom/llm": "workspace:^",
    "@fathom/llm-pi-ai": "workspace:^",
    "@fathom/scope": "workspace:^",
    "@fathom/sdk-protocol": "workspace:^",
    "@fathom/session": "workspace:^",
    "@fathom/session-persistence-jsonl": "workspace:^",
    "@fathom/subagent": "workspace:^"
  }
}
